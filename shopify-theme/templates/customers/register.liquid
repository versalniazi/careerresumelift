{% render 'breadcrumbs', current_title: 'Create Account' %}

<section class="section section--tight">
  <div class="container" style="max-width:440px;">
    <div class="card" style="padding:36px;" data-reveal>
      <h1 style="font-size:1.5rem;text-align:center;">Create Account</h1>

      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <div class="form-error" style="margin:16px 0;">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="form-row">
          <div class="form-field">
            <label for="FirstName">First name</label>
            <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
          </div>
          <div class="form-field">
            <label for="LastName">Last name</label>
            <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
          </div>
        </div>

        <div class="form-field">
          <label for="RegisterEmail">Email</label>
          <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required>
        </div>

        <div class="form-field">
          <label for="RegisterPassword">Password</label>
          <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
        </div>

        <button type="submit" class="btn btn--primary btn--block btn--lg">Create Account</button>
      {%- endform -%}

      <div style="text-align:center;margin-top:24px;padding-top:24px;border-top:1px solid var(--color-border);font-size:14px;">
        Already have an account? <a href="{{ routes.account_login_url }}" style="color:var(--color-secondary);">Sign in</a>
      </div>
    </div>
  </div>
</section>
