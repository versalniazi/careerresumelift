{% render 'breadcrumbs', current_title: 'About' %}

<section class="section">
  <div class="container">
    <div class="hero__grid" style="align-items:center;">
      <div data-reveal>
        <span class="eyebrow-badge">{{ section.settings.eyebrow }}</span>
        <h1 style="font-family:var(--font-heading);font-weight:800;font-size:clamp(2rem,4vw,2.75rem);margin:20px 0;">{{ section.settings.heading }}</h1>
        <div class="rich-text" style="margin:0;max-width:100%;font-size:18px;">
          {{ section.settings.body }}
        </div>
      </div>

      <div data-reveal data-reveal-delay="100">
        <div class="card" style="padding:32px;">
          <div style="display:flex;align-items:center;gap:16px;">
            <span style="display:flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:var(--radius-sm);background:var(--color-primary);color:var(--color-background);font-family:var(--font-heading);font-weight:800;font-size:20px;">{{ section.settings.initials }}</span>
            <div>
              <p style="font-family:var(--font-heading);font-weight:700;font-size:17px;">{{ section.settings.name }}</p>
              <p style="font-size:13px;color:var(--color-muted-text);">{{ section.settings.title }}</p>
            </div>
          </div>
          <div style="display:flex;flex-direction:column;gap:12px;margin-top:24px;padding-top:24px;border-top:1px solid var(--color-border);">
            {%- for block in section.blocks -%}
              <div style="display:flex;align-items:center;gap:10px;font-size:14px;" {{ block.shopify_attributes }}>
                {% render 'icon', name: block.settings.icon, width: 16, height: 16 %}
                {{ block.settings.label }}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Career Resume Lift" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built by a Certified Writer Who Understands What Gets You Hired" },
    { "type": "richtext", "id": "body", "label": "Body copy" },
    { "type": "text", "id": "name", "label": "Founder name", "default": "Muhammad Shair Khan" },
    { "type": "text", "id": "title", "label": "Founder title", "default": "Founder & Certified Professional Resume Writer (CPRW)" },
    { "type": "text", "id": "initials", "label": "Founder initials", "default": "MSK" }
  ],
  "blocks": [
    {
      "type": "credential",
      "name": "Credential",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "badge-check" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
