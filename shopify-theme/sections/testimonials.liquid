<section class="section{% if section.settings.muted_bg %} section--muted{% endif %}">
  <div class="container">
    <div class="section-heading" data-reveal>
      <span class="eyebrow-badge">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.description }}</p>
    </div>

    {%- if section.settings.show_ratings -%}
      <div class="rating-badges" data-reveal>
        <span class="badge" style="padding:8px 16px;font-size:14px;">{% render 'icon', name: 'star', width: 16, height: 16 %} {{ settings.google_rating }} on Google Reviews ({{ settings.google_review_count }})</span>
        <span class="badge" style="padding:8px 16px;font-size:14px;">{% render 'icon', name: 'star', width: 16, height: 16 %} {{ settings.trustpilot_rating }} on Trustpilot ({{ settings.trustpilot_review_count }})</span>
      </div>
    {%- endif -%}

    <div class="grid grid--3">
      {%- for block in section.blocks -%}
        <div class="card testimonial-card" data-reveal {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars">
            {%- for i in (1..block.settings.rating) -%}
              {% render 'icon', name: 'star', width: 15, height: 15 %}
            {%- endfor -%}
          </div>
          <p class="testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          {%- if block.settings.result != blank -%}
            <span class="badge badge--success" style="margin-top:16px;width:fit-content;">{{ block.settings.result }}</span>
          {%- endif -%}
          <div class="testimonial-card__person">
            <span class="testimonial-card__avatar">{{ block.settings.initials }}</span>
            <div>
              <p class="testimonial-card__name">{{ block.settings.name }}</p>
              <p class="testimonial-card__role">{{ block.settings.role }}</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Client Success" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Results From Real Job Seekers" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Thousands of professionals have trusted us to represent their careers on paper." },
    { "type": "checkbox", "id": "show_ratings", "label": "Show rating badges", "default": true },
    { "type": "checkbox", "id": "muted_bg", "label": "Muted background", "default": false }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "text", "id": "initials", "label": "Initials" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "result", "label": "Result badge (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "testimonial", "settings": { "name": "Amanda R.", "role": "Senior Marketing Director", "initials": "AR", "rating": 5, "quote": "The resume my writer delivered didn't just look better — it told a story recruiters actually responded to.", "result": "3 interviews in 2 weeks" } },
      { "type": "testimonial", "settings": { "name": "David C.", "role": "VP of Operations", "initials": "DC", "rating": 5, "quote": "As a VP, I needed a resume that spoke to boards and search firms, not just HR screeners.", "result": "Landed VP role in 6 weeks" } },
      { "type": "testimonial", "settings": { "name": "Priya N.", "role": "Registered Nurse, ICU", "initials": "PN", "rating": 5, "quote": "I hadn't updated my resume in eight years. My writer helped me translate years of clinical experience into a document that reflected my expertise.", "result": "" } }
    ]
  },
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
