{% render 'breadcrumbs', current_title: section.settings.breadcrumb_title %}

<section class="section section--tight">
  <div class="container">
    <div class="section-heading" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow-badge">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 style="font-family:var(--font-heading);font-weight:800;font-size:clamp(2rem,4vw,2.75rem);margin:16px 0;">{{ section.settings.heading }}</h1>
      <p>{{ section.settings.description }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "breadcrumb_title", "label": "Breadcrumb title" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "description", "label": "Description" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
