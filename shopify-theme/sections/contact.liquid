{% render 'breadcrumbs', current_title: 'Contact' %}

<section class="section section--tight">
  <div class="container">
    <div class="section-heading" data-reveal>
      <span class="eyebrow-badge">Contact Us</span>
      <h1 style="font-family:var(--font-heading);font-weight:800;font-size:clamp(2rem,4vw,2.75rem);margin:16px 0;">Let's Talk About Your Career Goals</h1>
      <p>Book a free resume review or send us a message — a real Certified Professional Resume Writer will respond within one business day.</p>
    </div>

    <div class="contact-columns" style="align-items:start;">
        <div class="card" style="padding:32px;" data-reveal>
          <h2 style="font-size:19px;">Send Us a Message</h2>
          <p style="font-size:14px;color:var(--color-muted-text);margin-top:4px;">Fill out the form and we'll get back to you within one business day.</p>

          {%- if form.posted_successfully? -%}
            <div class="form-success" style="margin-top:24px;">
              {% render 'icon', name: 'check', width: 40, height: 40 %}
              <p style="font-weight:700;font-size:17px;">Message Sent</p>
              <p style="color:var(--color-muted-text);font-size:14px;max-width:340px;">Thanks for reaching out. A member of our team will respond within one business day.</p>
            </div>
          {%- else -%}
            {%- form 'contact', id: 'ContactForm' -%}
              {%- if form.errors -%}
                <div class="form-error" style="margin-bottom:16px;">
                  {{ 'contact.form.error_heading' | t }}
                  <ul>
                    {%- for field in form.errors -%}
                      <li>{{ form.errors.messages[field] }}</li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

              <div class="form-row">
                <div class="form-field">
                  <label for="ContactFormName">{{ 'contact.form.name' | t }}</label>
                  <input type="text" id="ContactFormName" name="contact[name]" placeholder="Jane Doe" required>
                </div>
                <div class="form-field">
                  <label for="ContactFormEmail">{{ 'contact.form.email' | t }}</label>
                  <input type="email" id="ContactFormEmail" name="contact[email]" value="{{ form.email }}" placeholder="jane@email.com" required>
                </div>
              </div>

              <div class="form-row">
                <div class="form-field">
                  <label for="ContactFormPhone">{{ 'contact.form.phone' | t }}</label>
                  <input type="tel" id="ContactFormPhone" name="contact[phone]" placeholder="(555) 555-5555">
                </div>
                <div class="form-field">
                  <label for="ContactFormService">Service Interested In</label>
                  <select id="ContactFormService" name="contact[service]">
                    <option value="">Select a service</option>
                    <option value="Resume Writing">Resume Writing</option>
                    <option value="Executive Resume">Executive Resume</option>
                    <option value="Federal Resume">Federal Resume</option>
                    <option value="Military Resume">Military Resume</option>
                    <option value="Graduate Resume">Graduate Resume</option>
                    <option value="LinkedIn Optimization">LinkedIn Optimization</option>
                    <option value="Cover Letter">Cover Letter</option>
                    <option value="Career Coaching">Career Coaching</option>
                    <option value="Interview Coaching">Interview Coaching</option>
                    <option value="Not sure yet">Not Sure Yet</option>
                  </select>
                </div>
              </div>

              <div class="form-field">
                <label for="ContactFormMessage">{{ 'contact.form.message' | t }}</label>
                <textarea id="ContactFormMessage" name="contact[body]" placeholder="{{ 'contact.form.message_placeholder' | t }}" required>{{ form.body }}</textarea>
              </div>

              <button type="submit" class="btn btn--primary btn--lg">
                {% render 'icon', name: 'arrow-right', width: 18, height: 18 %}
                {{ 'contact.form.send' | t }}
              </button>
            {%- endform -%}
          {%- endif -%}
        </div>

        <div style="display:flex;flex-direction:column;gap:24px;">
          <div class="card" style="padding:28px;" data-reveal>
            <h3 style="font-size:16px;display:flex;align-items:center;gap:8px;">{% render 'icon', name: 'calendar', width: 20, height: 20 %} Book a Free Strategy Call</h3>
            <p style="font-size:14px;color:var(--color-muted-text);margin-top:8px;">Prefer to talk it through? Grab a time that works for you.</p>
            <div style="margin-top:16px;height:180px;border:2px dashed var(--color-border);border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--color-muted-text);text-align:center;font-size:14px;background:var(--color-muted);">
              {% render 'icon', name: 'calendar', width: 28, height: 28 %}
              Calendly scheduler embed
              <span style="font-size:12px;">(connect your Calendly link here)</span>
            </div>
          </div>

          <div class="card" style="padding:28px;" data-reveal>
            <h3 style="font-size:16px;">Contact Details</h3>
            <ul style="display:flex;flex-direction:column;gap:14px;margin-top:16px;font-size:14px;">
              <li style="display:flex;gap:10px;"><a href="mailto:{{ settings.business_email }}" style="display:flex;gap:10px;">{% render 'icon', name: 'mail', width: 16, height: 16 %} {{ settings.business_email }}</a></li>
              <li style="display:flex;gap:10px;"><a href="tel:{{ settings.business_phone }}" style="display:flex;gap:10px;">{% render 'icon', name: 'phone', width: 16, height: 16 %} {{ settings.business_phone }}</a></li>
              <li style="display:flex;gap:10px;color:var(--color-muted-text);">{% render 'icon', name: 'map-pin', width: 16, height: 16 %} {{ settings.business_address }}</li>
            </ul>
            <div style="margin-top:20px;padding-top:20px;border-top:1px solid var(--color-border);">
              <h4 style="font-size:14px;display:flex;align-items:center;gap:8px;">{% render 'icon', name: 'clock', width: 16, height: 16 %} Business Hours</h4>
              <ul style="margin-top:10px;display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--color-muted-text);">
                <li>{{ settings.business_hours_weekday }}</li>
                <li>{{ settings.business_hours_weekend }}</li>
              </ul>
            </div>
          </div>

          <div style="height:200px;border:2px dashed var(--color-border);border-radius:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--color-muted-text);text-align:center;font-size:14px;background:var(--color-muted);" data-reveal>
            {% render 'icon', name: 'map-pin', width: 28, height: 28 %}
            Google Map embed
          </div>
        </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact"
}
{% endschema %}
