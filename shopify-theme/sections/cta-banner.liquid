<section class="section">
  <div class="container">
    <div class="cta-banner" data-reveal>
      <div class="cta-banner__glow-a"></div>
      <div class="cta-banner__glow-b"></div>
      <div class="cta-banner__content">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.description }}</p>
        <div class="cta-banner__actions">
          <a href="{{ section.settings.primary_link }}" class="btn btn--white btn--lg">
            {{ section.settings.primary_label }}
            {% render 'icon', name: 'arrow-right', width: 18, height: 18 %}
          </a>
          <a href="{{ section.settings.secondary_link }}" class="btn btn--outline btn--lg" style="border-color:rgba(255,255,255,0.2);color:#fff;">
            {{ section.settings.secondary_label }}
          </a>
        </div>
        <div class="cta-banner__trust">
          <span>{% render 'icon', name: 'badge-check', width: 14, height: 14 %} CPRW Certified</span>
          <span>{% render 'icon', name: 'lock', width: 14, height: 14 %} 100% Confidential</span>
          <span>{% render 'icon', name: 'shield-check', width: 14, height: 14 %} Money-Back Guarantee</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to Land More Interviews?" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Get a free, no-obligation resume review from a Certified Professional Resume Writer within 24 hours." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Book Free Resume Review" },
    { "type": "url", "id": "primary_link", "label": "Primary button link", "default": "/pages/contact" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "View Pricing" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link", "default": "/collections/all" }
  ],
  "presets": [{ "name": "CTA banner" }]
}
{% endschema %}
