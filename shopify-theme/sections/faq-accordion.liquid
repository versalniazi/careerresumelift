<section class="section">
  <div class="container" style="max-width:760px;">
    <div class="section-heading" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow-badge">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}<p>{{ section.settings.description }}</p>{%- endif -%}
    </div>

    <div class="accordion" data-reveal>
      {%- for block in section.blocks -%}
        <div class="accordion-item" {{ block.shopify_attributes }}>
          <button class="accordion-trigger" type="button">
            {{ block.settings.question }}
            {% render 'icon', name: 'chevron-down', width: 18, height: 18 %}
          </button>
          <div class="accordion-content">
            <div class="accordion-content__inner">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ accordion",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Everything you need to know about working with Career Resume Lift." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "faq", "settings": { "question": "How does the resume writing process work?", "answer": "After you choose a package and complete checkout, you'll fill out a detailed intake questionnaire about your work history and goals. Your assigned Certified Professional Resume Writer researches your target role, drafts your resume, and delivers it within your package's turnaround window." } },
      { "type": "faq", "settings": { "question": "How long does it take to get my resume?", "answer": "Standard turnaround is 3–7 business days depending on your package, starting from when you submit your completed intake questionnaire." } },
      { "type": "faq", "settings": { "question": "Will my resume pass Applicant Tracking Systems (ATS)?", "answer": "Yes. Every resume is formatted and keyword-optimized specifically to parse correctly in major ATS platforms including Workday, Taleo, iCIMS, and Greenhouse." } },
      { "type": "faq", "settings": { "question": "Is there a money-back guarantee?", "answer": "Yes. If you're not satisfied after your revision rounds, we offer a satisfaction guarantee outlined in our Refund Policy." } }
    ]
  },
  "presets": [{ "name": "FAQ accordion" }]
}
{% endschema %}
