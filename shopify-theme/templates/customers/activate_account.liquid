<section class="section section--tight">
  <div class="container" style="max-width:440px;">
    <div class="card" style="padding:36px;">
      <h1 style="font-size:1.5rem;text-align:center;">Activate Your Account</h1>
      <p style="font-size:14px;color:var(--color-muted-text);text-align:center;margin-top:8px;">Create a password to activate your account.</p>

      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-error" style="margin:16px 0;">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="form-field">
          <label for="ActivatePassword">Password</label>
          <input type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
        </div>
        <div class="form-field">
          <label for="ActivatePasswordConfirm">Confirm password</label>
          <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
        </div>
        <button type="submit" name="accept" class="btn btn--primary btn--block btn--lg">Activate Account</button>
        <button type="submit" name="decline" class="btn btn--outline btn--block" style="margin-top:10px;">Decline Invitation</button>
      {%- endform -%}
    </div>
  </div>
</section>
