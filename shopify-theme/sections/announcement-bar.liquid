{%- if section.settings.enabled and section.settings.text != blank -%}
  <div class="announcement-bar">
    <div class="container announcement-bar__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        <span>{{ section.settings.text }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "CPRW Certified · ATS Optimized · 15,000+ Resumes Written · Free Resume Review This Week"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/pages/contact"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
