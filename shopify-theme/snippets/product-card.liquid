{%- comment -%} Usage: {% render 'product-card', product: product %} {%- endcomment -%}
<a href="{{ product.url }}" class="product-card" data-reveal>
  <div class="product-card__media">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.featured_media.alt }}
    {%- else -%}
      {% render 'icon', name: 'file-text', width: 32, height: 32 %}
    {%- endif -%}
  </div>
  <div class="product-card__body">
    <span class="badge badge--default" style="width:fit-content;">{{ product.type | default: 'Service' }}</span>
    <h3>{{ product.title }}</h3>
    <p>{{ product.description | strip_html | truncate: 110 }}</p>
    <div class="product-card__footer">
      <span class="product-card__price">
        {%- if product.price_varies -%}From {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
      </span>
      <span class="feature-card__link" style="margin-top:0;">
        {{ 'products.product.view_details' | t }}
        {% render 'icon', name: 'arrow-right', width: 14, height: 14 %}
      </span>
    </div>
  </div>
</a>
