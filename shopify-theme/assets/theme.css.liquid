/* ==========================================================================
   Career Resume Lift — Theme Stylesheet
   Design tokens mirror the brand system: Manrope (headings) / Inter (body)
   ========================================================================== */

:root {
  --color-primary: {{ settings.color_primary }};
  --color-secondary: {{ settings.color_secondary }};
  --color-accent: {{ settings.color_accent }};
  --color-success: {{ settings.color_success }};
  --color-background: {{ settings.color_background }};
  --color-muted: {{ settings.color_muted }};
  --color-border: {{ settings.color_border }};
  --color-text: {{ settings.color_text }};
  --color-muted-text: {{ settings.color_muted_text }};
  --color-destructive: #ef4444;
  --color-card: #ffffff;

  --font-heading: 'Manrope', ui-sans-serif, system-ui, sans-serif;
  --font-body: 'Inter', ui-sans-serif, system-ui, sans-serif;
  --heading-weight: {{ settings.heading_weight | default: 800 }};

  --page-width: {{ settings.page_width | default: 1280 }}px;
  --radius: {{ settings.border_radius | default: 20 }}px;
  --radius-sm: calc(var(--radius) - 12px);
  --radius-lg: calc(var(--radius) + 8px);

  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
  --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 20px 48px rgba(15, 23, 42, 0.12);
  --shadow-glow: 0 20px 48px rgba(37, 99, 235, 0.18);
}

:root[data-theme="dark"] {
  --color-primary: #f1f5f9;
  --color-secondary: #3b82f6;
  --color-accent: #22d3ee;
  --color-success: #4ade80;
  --color-background: #05070f;
  --color-muted: #0f172a;
  --color-border: #1e293b;
  --color-text: #f1f5f9;
  --color-muted-text: #94a3b8;
  --color-card: #0b1120;
}

/* ---------- Reset ---------- */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: var(--font-body);
  color: var(--color-text);
  background: var(--color-background);
  -webkit-font-smoothing: antialiased;
  transition: background-color .25s ease, color .25s ease;
}
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; background: none; border: none; color: inherit; }
input, textarea, select { font-family: inherit; font-size: 1rem; color: inherit; }
ul { margin: 0; padding: 0; list-style: none; }
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: var(--heading-weight);
  letter-spacing: -0.02em;
  margin: 0;
  line-height: 1.15;
}
p { margin: 0; }
::selection { background: var(--color-secondary); color: #fff; }

.skip-to-content {
  position: absolute; left: -9999px; top: 0; z-index: 999;
  background: var(--color-primary); color: #fff; padding: 12px 20px; border-radius: 0 0 8px 0;
}
.skip-to-content:focus { left: 0; }

.is-hidden { display: none !important; }
.hide-on-mobile { display: none; }
.show-on-mobile { display: inline-flex; }
@media (min-width: 900px) {
  .hide-on-mobile { display: inline-flex; }
  .show-on-mobile { display: none; }
}

.container {
  width: 100%;
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0 24px;
}

.main-content { min-height: 40vh; }

/* ---------- Typography helpers ---------- */
.eyebrow-badge {
  display: inline-flex; align-items: center; gap: 6px;
  border-radius: 999px; border: 1px solid rgba(37,99,235,0.2);
  background: rgba(37,99,235,0.1); color: var(--color-secondary);
  font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
  padding: 6px 14px;
}
.text-gradient {
  background: linear-gradient(120deg, var(--color-secondary), var(--color-accent));
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.section-heading { text-align: center; max-width: 720px; margin: 0 auto 56px; }
.section-heading--left { text-align: left; margin-left: 0; }
.section-heading h2 { font-size: clamp(1.9rem, 3.2vw, 2.6rem); margin: 16px 0; }
.section-heading p { color: var(--color-muted-text); font-size: 1.1rem; line-height: 1.6; }

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  border-radius: 999px; font-weight: 700; font-size: 15px; padding: 13px 26px;
  transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease, opacity .2s ease;
  border: 2px solid transparent; white-space: nowrap;
}
.btn--sm { padding: 9px 18px; font-size: 14px; }
.btn--lg { padding: 16px 32px; font-size: 16px; }
.btn--block { width: 100%; }
.btn--primary { background: var(--color-secondary); color: #fff; box-shadow: var(--shadow-glow); }
.btn--primary:hover { transform: translateY(-2px); opacity: .95; }
.btn--accent { background: var(--color-accent); color: var(--color-primary); }
.btn--accent:hover { transform: translateY(-2px); opacity: .92; }
.btn--outline { border-color: var(--color-border); color: var(--color-text); background: transparent; }
.btn--outline:hover { border-color: var(--color-secondary); color: var(--color-secondary); }
.btn--white { background: #fff; color: var(--color-primary); }
.btn--white:hover { transform: translateY(-2px); opacity: .95; }
.btn:disabled { opacity: .6; cursor: not-allowed; transform: none; }

.icon-button {
  display: inline-flex; align-items: center; justify-content: center;
  width: 40px; height: 40px; border-radius: 999px; position: relative;
  color: var(--color-text); transition: background-color .2s ease;
}
.icon-button:hover { background: var(--color-muted); }
.icon-button--outline { width: 36px; height: 36px; border: 1px solid var(--color-border); }
.icon-button--outline:hover { border-color: var(--color-secondary); color: var(--color-secondary); }

/* ---------- Badges ---------- */
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  border-radius: 999px; padding: 5px 13px; font-size: 12px; font-weight: 700;
  border: 1px solid var(--color-border);
}
.badge--default { background: rgba(37,99,235,0.1); color: var(--color-secondary); border-color: rgba(37,99,235,0.2); }
.badge--accent { background: rgba(6,182,212,0.1); color: var(--color-accent); border-color: rgba(6,182,212,0.2); }
.badge--success { background: rgba(34,197,94,0.1); color: var(--color-success); border-color: rgba(34,197,94,0.2); }
.badge--muted { background: var(--color-muted); color: var(--color-muted-text); }
.badge--solid { background: var(--color-primary); color: var(--color-background); border-color: var(--color-primary); }

/* ---------- Cards ---------- */
.card {
  background: var(--color-card); border: 1px solid var(--color-border);
  border-radius: var(--radius); box-shadow: var(--shadow-sm);
}

/* ---------- Header ---------- */
.announcement-bar { background: var(--color-primary); color: #fff; font-size: 13px; }
.announcement-bar__inner { padding: 8px 24px; text-align: center; }
.announcement-bar a:hover { text-decoration: underline; }

.site-header {
  position: sticky; top: 0; z-index: 50;
  background: color-mix(in srgb, var(--color-background) 88%, transparent);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--color-border);
}
.site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 80px; }
.site-header__logo { display: flex; align-items: center; gap: 10px; font-family: var(--font-heading); font-weight: 800; font-size: 19px; flex-shrink: 0; }
.site-header__logo-mark {
  display: flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; border-radius: 10px;
  background: var(--color-primary); color: var(--color-background); font-size: 15px; font-weight: 900;
}
.site-header__logo-text { display: none; }
@media (min-width: 640px) { .site-header__logo-text { display: inline; } }

.site-nav { display: none; align-items: center; gap: 2px; }
@media (min-width: 1024px) { .site-nav { display: flex; } }
.site-nav__item { position: relative; }
.site-nav__link {
  display: flex; align-items: center; gap: 4px; padding: 10px 16px; border-radius: 999px;
  font-size: 14px; font-weight: 600; color: color-mix(in srgb, var(--color-text) 80%, transparent);
  transition: background-color .2s ease, color .2s ease;
}
.site-nav__link:hover { background: var(--color-muted); color: var(--color-text); }
.site-nav__item--has-menu:hover .site-nav__dropdown,
.site-nav__item--has-menu:focus-within .site-nav__dropdown { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
.site-nav__item--has-menu:hover .site-nav__link svg { transform: rotate(180deg); }
.site-nav__link svg { transition: transform .2s ease; }

.site-nav__dropdown {
  position: absolute; left: 50%; top: 100%; transform: translate(-50%, 8px);
  width: 560px; margin-top: 8px; padding: 16px; border-radius: 20px;
  background: var(--color-card); border: 1px solid var(--color-border); box-shadow: var(--shadow-lg);
  opacity: 0; visibility: hidden; transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
  z-index: 60;
}
.site-nav__dropdown-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
.site-nav__dropdown-link { display: flex; align-items: flex-start; gap: 12px; padding: 12px; border-radius: 14px; transition: background-color .15s ease; }
.site-nav__dropdown-link:hover { background: var(--color-muted); }
.site-nav__dropdown-icon {
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  width: 36px; height: 36px; border-radius: 10px; background: rgba(37,99,235,0.1); color: var(--color-secondary); margin-top: 2px;
}
.site-nav__dropdown-title { font-size: 14px; font-weight: 700; }

.site-header__actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.cart-count {
  position: absolute; top: -2px; right: -2px; min-width: 16px; height: 16px; padding: 0 3px;
  border-radius: 999px; background: var(--color-secondary); color: #fff; font-size: 10px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}

/* theme toggle icon swap */
[data-theme-toggle] .icon-moon { display: none; }
:root[data-theme="dark"] [data-theme-toggle] .icon-sun { display: none; }
:root[data-theme="dark"] [data-theme-toggle] .icon-moon { display: block; }

/* ---------- Mobile nav ---------- */
.mobile-nav {
  position: fixed; inset: 80px 0 0 0; z-index: 45; background: var(--color-background);
  border-top: 1px solid var(--color-border); overflow-y: auto;
  transform: translateY(-12px); opacity: 0; visibility: hidden; transition: all .2s ease;
}
.mobile-nav.is-open { transform: translateY(0); opacity: 1; visibility: visible; }
@media (min-width: 1024px) { .mobile-nav { display: none; } }
.mobile-nav__inner { padding: 20px 24px 40px; display: flex; flex-direction: column; gap: 2px; }
.mobile-nav__link { padding: 14px 4px; font-size: 17px; font-weight: 700; border-bottom: 1px solid var(--color-border); }
.mobile-nav__submenu { display: flex; flex-direction: column; padding: 4px 4px 10px 12px; border-left: 2px solid var(--color-border); margin-left: 4px; }
.mobile-nav__sublink { padding: 8px 0; font-size: 14px; color: var(--color-muted-text); }
.mobile-nav__actions { display: flex; flex-direction: column; gap: 12px; margin-top: 20px; }

/* ---------- Footer ---------- */
.site-footer { background: var(--color-muted); border-top: 1px solid var(--color-border); padding: 64px 0 32px; margin-top: 96px; }
.footer-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; }
@media (min-width: 720px) { .footer-grid { grid-template-columns: repeat(3, 1fr); } }
@media (min-width: 1024px) { .footer-grid { grid-template-columns: 2fr repeat(3, 1fr); } }
.footer-brand { grid-column: 1 / -1; }
@media (min-width: 720px) { .footer-brand { grid-column: span 3; } }
@media (min-width: 1024px) { .footer-brand { grid-column: span 1; } }
.footer-brand__desc { margin: 16px 0; max-width: 360px; color: var(--color-muted-text); font-size: 14px; line-height: 1.6; }
.footer-social { display: flex; gap: 10px; }
.footer-col__title { font-size: 14px; font-weight: 700; margin-bottom: 16px; }
.footer-col__list { display: flex; flex-direction: column; gap: 11px; }
.footer-col__list a { font-size: 14px; color: var(--color-muted-text); transition: color .15s ease; }
.footer-col__list a:hover { color: var(--color-text); }
.footer-col__list--contact li { display: flex; align-items: flex-start; gap: 8px; font-size: 14px; color: var(--color-muted-text); }
.footer-col__list--contact a { display: flex; align-items: flex-start; gap: 8px; }
.footer-bottom {
  display: flex; flex-direction: column; gap: 16px; align-items: center; justify-content: space-between;
  border-top: 1px solid var(--color-border); margin-top: 56px; padding-top: 32px; font-size: 12px; color: var(--color-muted-text);
}
@media (min-width: 640px) { .footer-bottom { flex-direction: row; } }
.footer-bottom__legal { display: flex; flex-wrap: wrap; gap: 20px; }
.footer-bottom__legal a:hover { color: var(--color-text); }

/* ---------- Sticky CTA ---------- */
.sticky-cta {
  position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 40;
  background: color-mix(in srgb, var(--color-background) 95%, transparent);
  backdrop-filter: blur(16px); border: 1px solid var(--color-border); border-radius: 20px;
  box-shadow: var(--shadow-lg);
  transform: translateY(120%); transition: transform .3s ease;
}
.sticky-cta.is-visible { transform: translateY(0); }
@media (min-width: 640px) { .sticky-cta { left: auto; max-width: 380px; } }
.sticky-cta__inner { display: flex; align-items: center; gap: 14px; padding: 16px 18px; }
.sticky-cta__icon { display: none; flex-shrink: 0; padding: 10px; border-radius: 999px; background: rgba(37,99,235,0.1); color: var(--color-secondary); }
@media (min-width: 640px) { .sticky-cta__icon { display: flex; } }
.sticky-cta__text { flex: 1; }
.sticky-cta__heading { font-size: 14px; font-weight: 700; }
.sticky-cta__desc { font-size: 12px; color: var(--color-muted-text); margin-top: 2px; }
.sticky-cta__dismiss { flex-shrink: 0; color: var(--color-muted-text); }

/* ---------- Cart drawer ---------- */
.cart-drawer { position: fixed; inset: 0; z-index: 80; visibility: hidden; }
.cart-drawer.is-open { visibility: visible; }
.cart-drawer__overlay { position: absolute; inset: 0; background: rgba(5,7,15,0.5); opacity: 0; transition: opacity .25s ease; }
.cart-drawer.is-open .cart-drawer__overlay { opacity: 1; }
.cart-drawer__panel {
  position: absolute; top: 0; right: 0; bottom: 0; width: 100%; max-width: 420px;
  background: var(--color-background); box-shadow: var(--shadow-lg);
  display: flex; flex-direction: column; transform: translateX(100%); transition: transform .3s ease;
}
.cart-drawer.is-open .cart-drawer__panel { transform: translateX(0); }
.cart-drawer__header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--color-border); }
.cart-drawer__header h2 { font-size: 18px; }
.cart-drawer__body { flex: 1; overflow-y: auto; padding: 16px 24px; }
.cart-drawer__footer { padding: 20px 24px; border-top: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 10px; }
.cart-drawer__subtotal { display: flex; justify-content: space-between; font-weight: 700; margin-bottom: 6px; }

.cart-empty { text-align: center; padding: 40px 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.cart-empty__title { font-weight: 700; font-size: 16px; }
.cart-empty__desc { color: var(--color-muted-text); font-size: 14px; margin-bottom: 12px; }

.cart-items-list { display: flex; flex-direction: column; gap: 18px; }
.cart-item { display: flex; gap: 12px; position: relative; padding-right: 24px; }
.cart-item__image, .cart-item__image-placeholder {
  width: 72px; height: 72px; border-radius: 14px; overflow: hidden; flex-shrink: 0;
  background: var(--color-muted); display: flex; align-items: center; justify-content: center; color: var(--color-muted-text);
}
.cart-item__image img { width: 100%; height: 100%; object-fit: cover; }
.cart-item__details { flex: 1; min-width: 0; }
.cart-item__title { font-weight: 700; font-size: 14px; }
.cart-item__variant { font-size: 12px; color: var(--color-muted-text); margin-top: 2px; }
.cart-item__row { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; }
.cart-item__price { font-weight: 700; font-size: 14px; }
.cart-item__remove { position: absolute; top: 0; right: 0; color: var(--color-muted-text); }
.cart-item__remove:hover { color: var(--color-destructive); }

.quantity-stepper { display: flex; align-items: center; border: 1px solid var(--color-border); border-radius: 999px; overflow: hidden; }
.quantity-stepper button { width: 28px; height: 28px; font-size: 16px; }
.quantity-stepper button:hover { background: var(--color-muted); }
.quantity-stepper input { width: 32px; text-align: center; border: none; background: transparent; -moz-appearance: textfield; }
.quantity-stepper input::-webkit-outer-spin-button, .quantity-stepper input::-webkit-inner-spin-button { -webkit-appearance: none; }

/* ---------- Hero ---------- */
.hero { position: relative; overflow: hidden; padding: 64px 0 80px; }
@media (min-width: 640px) { .hero { padding: 96px 0 112px; } }
.hero__bg-grid {
  position: absolute; inset: 0; pointer-events: none;
  background-image: linear-gradient(to right, var(--color-border) 1px, transparent 1px), linear-gradient(to bottom, var(--color-border) 1px, transparent 1px);
  background-size: 44px 44px; opacity: .5;
  mask-image: radial-gradient(ellipse 60% 60% at 50% 0%, black 10%, transparent 75%);
}
.hero__glow { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 900px; height: 600px; background: var(--color-secondary); opacity: .12; filter: blur(90px); border-radius: 999px; pointer-events: none; z-index: -1; }
.hero__grid { position: relative; display: grid; grid-template-columns: 1fr; gap: 56px; align-items: center; }
@media (min-width: 1024px) { .hero__grid { grid-template-columns: 7fr 5fr; gap: 64px; } }
.hero__badges { display: flex; flex-wrap: wrap; gap: 10px; }
.hero h1 { font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.08; margin: 24px 0; }
.hero__desc { font-size: 1.15rem; line-height: 1.7; color: var(--color-muted-text); max-width: 540px; }
.hero__ctas { display: flex; flex-direction: column; gap: 14px; margin-top: 30px; }
@media (min-width: 640px) { .hero__ctas { flex-direction: row; } }
.hero__trust { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 36px; font-size: 14px; color: var(--color-muted-text); }
.hero__trust span { display: flex; align-items: center; gap: 8px; }
.hero__trust svg { color: var(--color-success); }

.hero-visual { position: relative; max-width: 420px; margin: 0 auto; }
.hero-card { position: relative; z-index: 2; border-radius: var(--radius-lg); background: var(--color-card); border: 1px solid var(--color-border); box-shadow: var(--shadow-lg); padding: 24px; animation: float 6s ease-in-out infinite; }
.hero-card__head { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding-bottom: 16px; }
.hero-card__name { font-family: var(--font-heading); font-weight: 700; font-size: 14px; }
.hero-card__role { font-size: 12px; color: var(--color-muted-text); }
.hero-card__check { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 999px; background: rgba(34,197,94,0.12); color: var(--color-success); }
.hero-card__lines { display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }
.hero-card__line { height: 10px; border-radius: 999px; background: var(--color-muted); }
.hero-card__score { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; padding: 12px 16px; border-radius: 14px; background: rgba(34,197,94,0.1); color: var(--color-success); font-weight: 700; font-size: 13px; }
.hero-float { position: absolute; z-index: 3; border-radius: var(--radius); background: var(--color-card); border: 1px solid var(--color-border); box-shadow: var(--shadow-lg); padding: 14px 18px; display: none; }
@media (min-width: 640px) { .hero-float { display: block; } }
.hero-float--stat { left: -40px; top: -56px; animation: float 5s ease-in-out infinite .5s; }
.hero-float--stat span { display: block; }
.hero-float__label { font-size: 12px; color: var(--color-muted-text); }
.hero-float__value { font-family: var(--font-heading); font-size: 22px; font-weight: 800; color: var(--color-secondary); }
.hero-float--avatars { right: -24px; bottom: 16px; display: flex; align-items: center; gap: 8px; animation: float 5.5s ease-in-out infinite 1s; }
.hero-float__avatars { display: flex; }
.hero-float__avatars span { width: 28px; height: 28px; border-radius: 999px; border: 2px solid var(--color-card); background: rgba(6,182,212,0.2); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; margin-left: -8px; }
.hero-float__avatars span:first-child { margin-left: 0; }
.hero-glow-blur { position: absolute; inset: 0; z-index: 1; border-radius: var(--radius-lg); background: linear-gradient(135deg, rgba(37,99,235,0.3), rgba(6,182,212,0.2)); filter: blur(32px); }

@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes fade-up { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }

/* ---------- Scroll reveal ---------- */
[data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity .6s cubic-bezier(.21,.47,.32,.98), transform .6s cubic-bezier(.21,.47,.32,.98); }
[data-reveal].is-visible { opacity: 1; transform: translateY(0); }

/* ---------- Sections (generic) ---------- */
.section { padding: 72px 0; }
.section--tight { padding: 56px 0; }
.section--muted { background: var(--color-muted); }

/* Trust bar */
.trust-bar { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-muted) 60%, transparent); padding: 24px 0; }
.trust-bar__row { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px; }
.trust-bar__item { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--color-muted-text); }
.trust-bar__item svg { color: var(--color-secondary); }

/* Logo marquee */
.logo-cloud { padding: 40px 0; overflow: hidden; }
.logo-cloud__label { text-align: center; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--color-muted-text); margin-bottom: 24px; }
.logo-cloud__track { display: flex; width: max-content; gap: 64px; animation: marquee 40s linear infinite; }
.logo-cloud__track span { font-family: var(--font-heading); font-weight: 800; font-size: 22px; color: var(--color-muted-text); opacity: .5; white-space: nowrap; }

/* Stats */
.stats-panel { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; border-radius: var(--radius-lg); border: 1px solid var(--color-border); background: var(--color-card); box-shadow: var(--shadow-sm); padding: 48px 32px; }
@media (min-width: 900px) { .stats-panel { grid-template-columns: repeat(4, 1fr); padding: 48px 60px; } }
.stat { text-align: center; }
.stat__value { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; }
.stat__label { font-size: 14px; color: var(--color-muted-text); margin-top: 8px; }

/* Grid layouts */
.grid { display: grid; gap: 24px; }
.grid--2 { grid-template-columns: 1fr; }
.grid--3 { grid-template-columns: 1fr; }
.grid--4 { grid-template-columns: 1fr; }
@media (min-width: 640px) { .grid--2 { grid-template-columns: repeat(2, 1fr); } .grid--3 { grid-template-columns: repeat(2, 1fr); } .grid--4 { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .grid--3 { grid-template-columns: repeat(3, 1fr); } .grid--4 { grid-template-columns: repeat(4, 1fr); } }

/* Feature / service card */
.feature-card { display: flex; flex-direction: column; height: 100%; border-radius: var(--radius); background: var(--color-card); border: 1px solid var(--color-border); padding: 28px; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
.feature-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: color-mix(in srgb, var(--color-secondary) 40%, var(--color-border)); }
.feature-card__icon { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 14px; background: rgba(37,99,235,0.1); color: var(--color-secondary); transition: background-color .2s ease, color .2s ease; }
.feature-card:hover .feature-card__icon { background: var(--color-secondary); color: #fff; }
.feature-card h3 { font-size: 17px; margin-top: 18px; }
.feature-card p { font-size: 14px; color: var(--color-muted-text); line-height: 1.6; margin-top: 8px; flex: 1; }
.feature-card__link { display: inline-flex; align-items: center; gap: 6px; margin-top: 18px; font-size: 14px; font-weight: 700; color: var(--color-secondary); }
.feature-card__link svg { transition: transform .2s ease; }
.feature-card:hover .feature-card__link svg { transform: translateX(3px); }

/* Simple stat/reason card (why-choose-us, process) */
.reason-card { border-radius: var(--radius); background: var(--color-card); padding: 26px; box-shadow: var(--shadow-sm); height: 100%; }
.reason-card__icon { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 14px; background: var(--color-primary); color: var(--color-background); }
.reason-card h3 { font-size: 17px; margin-top: 18px; }
.reason-card p { font-size: 14px; color: var(--color-muted-text); line-height: 1.6; margin-top: 8px; }

.process-card { position: relative; height: 100%; border-radius: var(--radius); border: 1px solid var(--color-border); background: var(--color-card); padding: 26px; transition: transform .2s ease, box-shadow .2s ease; }
.process-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.process-card__number { font-family: var(--font-heading); font-size: 2.4rem; font-weight: 800; color: color-mix(in srgb, var(--color-secondary) 22%, transparent); }
.process-card h3 { font-size: 16px; margin-top: 10px; }
.process-card p { font-size: 14px; color: var(--color-muted-text); line-height: 1.6; margin-top: 8px; }

/* Before / after */
.compare-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
@media (min-width: 768px) { .compare-grid { grid-template-columns: 1fr 1fr; } }
.compare-card { border-radius: var(--radius-lg); padding: 32px; height: 100%; }
.compare-card--before { border: 1px solid rgba(239,68,68,0.2); background: rgba(239,68,68,0.05); }
.compare-card--after { border: 1px solid rgba(34,197,94,0.3); background: rgba(34,197,94,0.05); }
.compare-card__badge { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 5px 13px; font-size: 12px; font-weight: 700; margin-bottom: 16px; }
.compare-card--before .compare-card__badge { background: rgba(239,68,68,0.1); color: var(--color-destructive); }
.compare-card--after .compare-card__badge { background: rgba(34,197,94,0.1); color: var(--color-success); }
.compare-card h3 { font-size: 19px; }
.compare-card ul { margin-top: 22px; display: flex; flex-direction: column; gap: 14px; }
.compare-card li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; }
.compare-card--before li { color: var(--color-muted-text); }
.compare-card--before svg { color: var(--color-destructive); opacity: .7; flex-shrink: 0; margin-top: 2px; }
.compare-card--after svg { color: var(--color-success); flex-shrink: 0; margin-top: 2px; }

/* Testimonials */
.testimonial-card { display: flex; flex-direction: column; height: 100%; padding: 26px; }
.testimonial-card__stars { display: flex; gap: 2px; color: var(--color-accent); margin-bottom: 12px; }
.testimonial-card__stars svg { fill: currentColor; }
.testimonial-card__quote { flex: 1; font-size: 14px; line-height: 1.7; }
.testimonial-card__result { margin-top: 16px; }
.testimonial-card__person { display: flex; align-items: center; gap: 12px; margin-top: 20px; border-top: 1px solid var(--color-border); padding-top: 16px; }
.testimonial-card__avatar { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 999px; background: rgba(37,99,235,0.1); color: var(--color-secondary); font-size: 13px; font-weight: 700; flex-shrink: 0; }
.testimonial-card__name { font-size: 14px; font-weight: 700; }
.testimonial-card__role { font-size: 12px; color: var(--color-muted-text); }
.rating-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-bottom: 48px; }

/* Pricing cards */
.pricing-card { position: relative; display: flex; flex-direction: column; height: 100%; border-radius: var(--radius-lg); border: 1px solid var(--color-border); background: var(--color-card); padding: 32px; transition: transform .2s ease, box-shadow .2s ease; }
.pricing-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.pricing-card--highlighted { border-color: var(--color-secondary); background: var(--color-primary); color: var(--color-background); box-shadow: var(--shadow-glow); }
.pricing-card__badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: var(--color-accent); color: var(--color-primary); }
.pricing-card h3 { font-size: 19px; }
.pricing-card__desc { font-size: 14px; margin-top: 8px; color: var(--color-muted-text); }
.pricing-card--highlighted .pricing-card__desc { color: rgba(255,255,255,0.7); }
.pricing-card__price { font-family: var(--font-heading); font-size: 2.4rem; font-weight: 800; margin-top: 22px; }
.pricing-card__turnaround { font-size: 12px; font-weight: 700; color: var(--color-secondary); margin-top: 2px; }
.pricing-card--highlighted .pricing-card__turnaround { color: var(--color-accent); }
.pricing-card ul { flex: 1; display: flex; flex-direction: column; gap: 12px; margin-top: 22px; }
.pricing-card li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; }
.pricing-card li svg { flex-shrink: 0; margin-top: 3px; color: var(--color-success); }
.pricing-card--highlighted li svg { color: var(--color-accent); }
.pricing-card .btn { margin-top: 28px; }

/* Comparison table */
.compare-table-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--color-border); }
.compare-table { width: 100%; min-width: 640px; border-collapse: collapse; font-size: 14px; }
.compare-table th, .compare-table td { padding: 16px; text-align: left; }
.compare-table thead { background: var(--color-muted); }
.compare-table th { font-family: var(--font-heading); font-weight: 700; }
.compare-table tbody tr:nth-child(even) { background: color-mix(in srgb, var(--color-muted) 40%, transparent); }
.compare-table svg.icon--check { color: var(--color-success); }
.compare-table svg.icon--x { color: color-mix(in srgb, var(--color-muted-text) 40%, transparent); }

/* CTA banner */
.cta-banner { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-primary); color: var(--color-background); text-align: center; padding: 64px 24px; }
@media (min-width: 640px) { .cta-banner { padding: 72px 60px; } }
.cta-banner__glow-a { position: absolute; top: -96px; right: 0; width: 280px; height: 280px; border-radius: 999px; background: var(--color-secondary); opacity: .3; filter: blur(70px); }
.cta-banner__glow-b { position: absolute; bottom: -96px; left: 0; width: 280px; height: 280px; border-radius: 999px; background: var(--color-accent); opacity: .2; filter: blur(70px); }
.cta-banner__content { position: relative; max-width: 640px; margin: 0 auto; }
.cta-banner h2 { font-size: clamp(1.8rem, 3.4vw, 2.4rem); }
.cta-banner p { margin-top: 16px; color: rgba(255,255,255,0.72); }
.cta-banner__actions { display: flex; flex-direction: column; gap: 14px; justify-content: center; margin-top: 30px; }
@media (min-width: 640px) { .cta-banner__actions { flex-direction: row; } }
.cta-banner__trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 22px; margin-top: 30px; font-size: 12px; color: rgba(255,255,255,0.6); }
.cta-banner__trust span { display: flex; align-items: center; gap: 6px; }

/* Accordion (FAQ) */
.accordion { border-radius: var(--radius); border: 1px solid var(--color-border); background: var(--color-card); padding: 0 24px; }
.accordion-item { border-bottom: 1px solid var(--color-border); }
.accordion-item:last-child { border-bottom: none; }
.accordion-trigger { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 0; text-align: left; font-family: var(--font-heading); font-weight: 700; font-size: 15px; }
.accordion-trigger:hover { color: var(--color-secondary); }
.accordion-trigger svg { flex-shrink: 0; color: var(--color-muted-text); transition: transform .25s ease; }
.accordion-item.is-open .accordion-trigger svg { transform: rotate(180deg); }
.accordion-content { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
.accordion-content__inner { padding-bottom: 20px; font-size: 14px; color: var(--color-muted-text); line-height: 1.7; }

/* Breadcrumbs */
.breadcrumbs { border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent); background: color-mix(in srgb, var(--color-muted) 40%, transparent); }
.breadcrumbs__inner { display: flex; align-items: center; gap: 6px; padding: 12px 24px; font-size: 12px; color: var(--color-muted-text); overflow-x: auto; }
.breadcrumbs__inner a:hover { color: var(--color-text); }
.breadcrumbs__current { font-weight: 600; color: var(--color-text); }

/* Forms */
.form-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
.form-field label { font-size: 14px; font-weight: 600; }
.form-field input, .form-field textarea, .form-field select {
  border: 1px solid var(--color-border); border-radius: 12px; padding: 12px 16px; background: var(--color-background); color: var(--color-text);
  transition: border-color .15s ease, box-shadow .15s ease;
}
.form-field textarea { min-height: 128px; resize: vertical; }
.form-field input:focus, .form-field textarea:focus, .form-field select:focus { outline: none; border-color: var(--color-secondary); box-shadow: 0 0 0 3px rgba(37,99,235,0.15); }
.form-row { display: grid; grid-template-columns: 1fr; gap: 0 18px; }
@media (min-width: 640px) { .form-row { grid-template-columns: 1fr 1fr; } }
.form-error { color: var(--color-destructive); font-size: 12px; }
.form-success { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; padding: 40px; border-radius: var(--radius); background: rgba(34,197,94,0.08); }
.form-success svg { color: var(--color-success); }

/* Product page */
.product-layout { display: grid; grid-template-columns: 1fr; gap: 48px; }
@media (min-width: 960px) { .product-layout { grid-template-columns: 1fr 1fr; } }
.product-gallery { position: sticky; top: 100px; align-self: start; }
.product-gallery__main { border-radius: var(--radius-lg); overflow: hidden; background: var(--color-muted); aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; }
.product-gallery__main img { width: 100%; height: 100%; object-fit: cover; }
.product-gallery__placeholder { display: flex; flex-direction: column; align-items: center; gap: 10px; color: var(--color-muted-text); }
.product-info h1 { font-size: clamp(1.7rem, 3vw, 2.2rem); margin: 14px 0; }
.product-price { font-family: var(--font-heading); font-size: 2rem; font-weight: 800; margin: 12px 0; }
.product-price del { color: var(--color-muted-text); font-size: 1.1rem; font-weight: 500; margin-right: 10px; }
.product-form fieldset { border: none; padding: 0; margin: 0 0 20px; }
.product-form legend { font-size: 14px; font-weight: 700; margin-bottom: 10px; }
.variant-options { display: flex; flex-direction: column; gap: 10px; }
.variant-option { position: relative; }
.variant-option input { position: absolute; opacity: 0; pointer-events: none; }
.variant-option label {
  display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer;
  border: 2px solid var(--color-border); border-radius: 14px; padding: 14px 18px; transition: border-color .15s ease, background-color .15s ease;
}
.variant-option input:checked + label { border-color: var(--color-secondary); background: rgba(37,99,235,0.06); }
.variant-option__name { font-weight: 700; font-size: 14px; }
.variant-option__meta { font-size: 12px; color: var(--color-muted-text); margin-top: 2px; }
.variant-option__price { font-weight: 700; }
.product-benefits { display: flex; flex-direction: column; gap: 14px; margin: 28px 0; }
.product-benefit { display: flex; align-items: flex-start; gap: 12px; }
.product-benefit svg { flex-shrink: 0; margin-top: 3px; color: var(--color-success); }
.product-description { font-size: 14px; line-height: 1.75; color: var(--color-muted-text); }
.product-description h2, .product-description h3 { color: var(--color-text); margin-top: 24px; margin-bottom: 8px; }

/* Collection grid */
.collection-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 32px; }
.product-card { display: flex; flex-direction: column; height: 100%; border-radius: var(--radius); border: 1px solid var(--color-border); background: var(--color-card); overflow: hidden; transition: transform .2s ease, box-shadow .2s ease; }
.product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.product-card__media { aspect-ratio: 16/10; background: var(--color-muted); display: flex; align-items: center; justify-content: center; color: var(--color-muted-text); overflow: hidden; }
.product-card__media img { width: 100%; height: 100%; object-fit: cover; }
.product-card__body { padding: 22px; display: flex; flex-direction: column; flex: 1; }
.product-card h3 { font-size: 16px; }
.product-card p { font-size: 13px; color: var(--color-muted-text); margin-top: 8px; flex: 1; line-height: 1.6; }
.product-card__footer { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; }
.product-card__price { font-weight: 800; font-family: var(--font-heading); }

/* Blog */
.blog-card { display: flex; flex-direction: column; height: 100%; border-radius: var(--radius); border: 1px solid var(--color-border); overflow: hidden; background: var(--color-card); transition: transform .2s ease, box-shadow .2s ease; }
.blog-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.blog-card__media { height: 160px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(37,99,235,0.2), rgba(6,182,212,0.15)); overflow: hidden; }
.blog-card__media img { width: 100%; height: 100%; object-fit: cover; }
.blog-card__media span { font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800; color: rgba(15,23,42,0.08); }
.blog-card__body { padding: 22px; display: flex; flex-direction: column; flex: 1; }
.blog-card h3 { font-size: 16px; margin: 10px 0 8px; }
.blog-card p { font-size: 13px; color: var(--color-muted-text); flex: 1; line-height: 1.6; }
.blog-card__meta { display: flex; justify-content: space-between; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--color-border); font-size: 11px; color: var(--color-muted-text); }
.blog-categories { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 28px; }
.blog-categories a { border: 1px solid var(--color-border); border-radius: 999px; padding: 8px 16px; font-size: 13px; font-weight: 600; color: var(--color-muted-text); transition: all .15s ease; }
.blog-categories a:hover, .blog-categories a.is-active { border-color: var(--color-secondary); color: var(--color-secondary); }

.article { max-width: 720px; margin: 0 auto; }
.article__meta { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--color-muted-text); margin: 16px 0 32px; flex-wrap: wrap; }
.article__body { font-size: 16px; line-height: 1.8; color: var(--color-muted-text); }
.article__body h2 { color: var(--color-text); font-size: 1.4rem; margin: 32px 0 12px; }
.article__body h3 { color: var(--color-text); font-size: 1.15rem; margin: 24px 0 10px; }
.article__body p { margin-bottom: 16px; }
.article__body ul, .article__body ol { margin: 0 0 16px; padding-left: 22px; }
.article__body li { margin-bottom: 8px; }
.article__body a { color: var(--color-secondary); text-decoration: underline; }
.article__body strong { color: var(--color-text); }
.article__body blockquote { border-left: 3px solid var(--color-secondary); padding-left: 18px; margin: 24px 0; font-style: italic; }

/* Rich text / page content */
.rich-text { max-width: 760px; margin: 0 auto; font-size: 16px; line-height: 1.8; color: var(--color-muted-text); }
.rich-text h1 { color: var(--color-text); font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 8px; }
.rich-text h2 { color: var(--color-text); font-size: 1.35rem; margin: 28px 0 10px; }
.rich-text h3 { color: var(--color-text); font-size: 1.1rem; margin: 20px 0 8px; }
.rich-text p { margin-bottom: 14px; }
.rich-text ul, .rich-text ol { margin: 0 0 14px; padding-left: 20px; }
.rich-text a { color: var(--color-secondary); text-decoration: underline; }

/* Industries / resources grid item reuses .feature-card */
.industry-hero-icon, .resource-icon {
  display: flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: var(--radius-sm);
  background: var(--color-primary); color: var(--color-background); margin: 0 auto 20px;
}

/* Empty state */
.empty-state { text-align: center; padding: 64px 24px; border: 2px dashed var(--color-border); border-radius: var(--radius); color: var(--color-muted-text); }

/* 404 */
.error-page { min-height: 60vh; display: flex; align-items: center; padding: 80px 0; text-align: center; }
.error-page__icon { display: flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: var(--radius-sm); background: var(--color-primary); color: var(--color-background); margin: 0 auto 24px; }
.error-page h1 { font-size: clamp(2rem, 4vw, 3rem); }
.error-page p { color: var(--color-muted-text); margin-top: 16px; font-size: 1.1rem; }
.error-page__actions { display: flex; flex-direction: column; gap: 14px; justify-content: center; margin-top: 32px; }
@media (min-width: 640px) { .error-page__actions { flex-direction: row; } }

/* Contact page */
.contact-columns { display: grid; grid-template-columns: 1fr; gap: 40px; }
@media (min-width: 960px) { .contact-columns { grid-template-columns: 3fr 2fr; } }

/* Cart page */
.cart-page { display: grid; grid-template-columns: 1fr; gap: 40px; }
@media (min-width: 960px) { .cart-page { grid-template-columns: 2fr 1fr; } }
.cart-summary { border-radius: var(--radius); border: 1px solid var(--color-border); padding: 24px; height: fit-content; position: sticky; top: 100px; }
.cart-summary__row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 10px; color: var(--color-muted-text); }
.cart-summary__total { display: flex; justify-content: space-between; font-weight: 800; font-size: 18px; margin: 16px 0; padding-top: 16px; border-top: 1px solid var(--color-border); }

/* Utility spacing */
.mt-0 { margin-top: 0; }
.text-center { text-align: center; }
