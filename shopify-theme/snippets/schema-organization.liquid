{%- comment -%} Organization + LocalBusiness JSON-LD, rendered once in theme.liquid head {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "description": {{ shop.description | default: page_description | json }},
  "telephone": {{ settings.business_phone | json }},
  "email": {{ settings.business_email | json }},
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ settings.business_address | json }},
    "addressCountry": "US"
  },
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ settings.google_rating | json }},
    "reviewCount": "1240",
    "bestRating": "5"
  },
  "sameAs": [
    {{ settings.social_linkedin_link | json }},
    {{ settings.social_facebook_link | json }},
    {{ settings.social_instagram_link | json }},
    {{ settings.social_twitter_link | json }}
  ]
}
</script>
