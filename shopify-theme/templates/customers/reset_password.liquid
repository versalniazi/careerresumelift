<section class="section section--tight">
  <div class="container" style="max-width:440px;">
    <div class="card" style="padding:36px;">
      <h1 style="font-size:1.5rem;text-align:center;">Reset Your Password</h1>
      <p style="font-size:14px;color:var(--color-muted-text);text-align:center;margin-top:8px;">Enter a new password for {{ email }}.</p>

      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-error" style="margin:16px 0;">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="form-field">
          <label for="ResetPassword">New password</label>
          <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
        </div>
        <div class="form-field">
          <label for="ResetPasswordConfirm">Confirm password</label>
          <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--block btn--lg">Reset Password</button>
      {%- endform -%}
    </div>
  </div>
</section>
