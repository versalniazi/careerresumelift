{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'arrow-right', width: 20, height: 20, class: 'my-class' %}
{%- endcomment -%}
{%- liquid
  assign icon_width = width | default: 20
  assign icon_height = height | default: 20
-%}
<svg class="icon icon--{{ name }}{% if class %} {{ class }}{% endif %}" width="{{ icon_width }}" height="{{ icon_height }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- case name -%}
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 5l7 7-7 7"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="M9 18l6-6-6-6"/>
    {%- when 'x' -%}
      <path d="M18 6L6 18M6 6l12 12"/>
    {%- when 'check' -%}
      <path d="M20 6L9 17l-5-5"/>
    {%- when 'menu' -%}
      <path d="M3 12h18M3 6h18M3 18h18"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
    {%- when 'shopping-bag' -%}
      <path d="M6 2l1.5 4h9L18 2"/><path d="M3.5 8h17l-1.4 12.2a2 2 0 0 1-2 1.8H6.9a2 2 0 0 1-2-1.8L3.5 8z"/><path d="M8.5 11a3.5 3.5 0 0 0 7 0"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
    {%- when 'moon' -%}
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    {%- when 'star' -%}
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    {%- when 'home' -%}
      <path d="M3 9.5L12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/>
    {%- when 'map-pin' -%}
      <path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
    {%- when 'mail' -%}
      <rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/>
    {%- when 'phone' -%}
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
    {%- when 'calendar' -%}
      <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
    {%- when 'download' -%}
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/>
    {%- when 'lock' -%}
      <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    {%- when 'zap' -%}
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
    {%- when 'shield-check' -%}
      <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'badge-check' -%}
      <circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/>
    {%- when 'scan-search' -%}
      <path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3.5"/><path d="M14.5 14.5L17 17"/>
    {%- when 'quote' -%}
      <path d="M7 11c0-3 1.7-5.4 5-6v2.3c-1.7.5-2.5 1.7-2.5 3.2H12v5H7v-4.5zM15 11c0-3 1.7-5.4 5-6v2.3c-1.7.5-2.5 1.7-2.5 3.2H20v5h-5v-4.5z"/>
    {%- when 'trending-up' -%}
      <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
    {%- when 'file-text' -%}
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h6M9 9h1"/>
    {%- when 'users' -%}
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
    {%- when 'linkedin' -%}
      <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56z" fill="currentColor" stroke="none"/>
    {%- when 'twitter' -%}
      <path d="M18.9 3h3.05l-6.67 7.62L23.2 21h-6.15l-4.82-6.3L6.7 21H3.65l7.13-8.15L2.8 3h6.3l4.36 5.77zm-1.07 16.2h1.69L7.28 4.7H5.47z" fill="currentColor" stroke="none"/>
    {%- when 'facebook' -%}
      <path d="M14.5 21v-7.7h2.58l.39-3h-2.97V8.4c0-.87.24-1.46 1.49-1.46h1.59V4.24C17.24 4.2 16.3 4.1 15.2 4.1c-2.3 0-3.87 1.4-3.87 3.97v2.22H8.75v3h2.58V21z" fill="currentColor" stroke="none"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'target' -%}
      <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>
  {%- endcase -%}
</svg>
